library(jsonlite)
DWCA_DIRS <- c("gbif_newberryi", "gbif_davidsonii")   # one folder per GBIF download;
# a single folder is fine too
IMAGE_DIR <- "images"
SPECIES   <- c("newberryi", "davidsonii")
N_PER_SP  <- 50           # observations per species
SEED      <- 1             # fixed, so the batch is reproducible
PAUSE     <- 0.3           # seconds between downloads
dir.create(IMAGE_DIR, showWarnings = FALSE)
# GBIF text files contain unescaped quotes and apostrophes in place names and
# people's names. Without quote="" read.delim silently swallows rows.
# Columns are named explicitly so archives downloaded at different times still stack.
readDwCA <- function(dirs, fname, keep) {
parts <- lapply(dirs, function(d) {
x <- read.delim(file.path(d, fname), quote = "", na.strings = "",
stringsAsFactors = FALSE, fileEncoding = "UTF-8")
missing <- setdiff(keep, names(x))
if (length(missing)) stop(fname, " in ", d, " lacks: ", paste(missing, collapse = ", "))
x[, keep]
})
unique(do.call(rbind, parts))
}
occ <- readDwCA(DWCA_DIRS, "occurrence.txt",
c("gbifID", "genus", "specificEpithet", "decimalLatitude",
"decimalLongitude", "eventDate", "stateProvince", "license"))
mm  <- readDwCA(DWCA_DIRS, "multimedia.txt",
c("gbifID", "identifier", "creator"))
cat("read", nrow(occ), "occurrences and", nrow(mm), "media records\n")
# keep the two target species, with coordinates
occ <- occ[occ$specificEpithet %in% SPECIES, ]
occ <- occ[!is.na(occ$decimalLatitude) & !is.na(occ$decimalLongitude), ]
# GBIF only publishes iNaturalist records under CC0, CC BY or CC BY-NC, so this is a
# check rather than a real filter. The column arrives either as a URI
# (http://creativecommons.org/licenses/by-nc/4.0/legalcode) or as a code
# (CC_BY_NC_4_0) depending on the download, so match both, and never silently
# discard everything if neither form is recognised.
cat("\nlicence values present:\n")
print(table(occ$license, useNA = "ifany"))
reusable <- grepl("zero|cc0|/by/|by[-_]nc|cc[-_]by", occ$license, ignore.case = TRUE)
if (!any(reusable)) {
warning("No licence value was recognised, so none were dropped. Check the table above.")
} else {
cat("dropping", sum(!reusable), "records without a reusable licence\n")
occ <- occ[reusable, ]
}
# one photo per observation, the first listed
mm <- mm[!duplicated(mm$gbifID), ]
occ <- merge(occ[, c("gbifID", "genus", "specificEpithet", "decimalLatitude",
"decimalLongitude", "eventDate", "stateProvince", "license")],
mm[, c("gbifID", "identifier", "creator")],
by = "gbifID")
occ <- occ[!is.na(occ$identifier), ]
cat(nrow(occ), "observations have a usable photo\n")
print(table(occ$specificEpithet))
# draw the batch
set.seed(SEED)
batch <- do.call(rbind, lapply(split(occ, occ$specificEpithet), function(d) {
d[sample(nrow(d), min(N_PER_SP, nrow(d))), ]
}))
# interleave the species so scoring order is not confounded with species
batch <- batch[sample(nrow(batch)), ]
# iNaturalist serves a ~500px "medium" by default; large leaves enough corolla to click
batch$url <- sub("/medium\\.", "/large.", batch$identifier)
cat("\ndownloading", nrow(batch), "images\n")
ok <- logical(nrow(batch))
for (i in seq_len(nrow(batch))) {
dest <- file.path(IMAGE_DIR, paste0(batch$gbifID[i], ".jpg"))
if (file.exists(dest) && file.size(dest) > 5000) { ok[i] <- TRUE; next }
ok[i] <- tryCatch({
download.file(batch$url[i], dest, mode = "wb", quiet = TRUE)
file.exists(dest) && file.size(dest) > 5000
}, error = function(e) FALSE)
if (!ok[i]) cat("  failed:", batch$gbifID[i], "\n")
Sys.sleep(PAUSE)
if (i %% 25 == 0) cat("  ", i, "of", nrow(batch), "\n")
}
cat("downloaded", sum(ok), "of", nrow(batch), "\n")
library(jsonlite)
DWCA_DIRS <- c("gbif_newberryi", "gbif_davidsonii")   # one folder per GBIF download;
library(jsonlite)
DWCA_DIRS <- c("gbif_newberryi", "gbif_davidsonii")   # one folder per GBIF download;
# a single folder is fine too
IMAGE_DIR <- "../../penstemon-color-images/images"    # in the image repo
MANIFEST  <- "manifest.json"        # stays here; the page reads /color/manifest.json
META_LOG  <- "batch_metadata.csv"   # stays here; appended, never replaced
SPECIES   <- c("newberryi", "davidsonii")
BATCH     <- 1             # bump this by one for each new batch
N_PER_SP  <- 5           # observations per species per batch
SEED      <- 1             # fixed, so each batch number is reproducible
PAUSE     <- 0.3           # seconds between downloads
# refuse to run if the image repo is not where we think it is, rather than quietly
# creating a stray folder inside the website repo
if (!dir.exists(dirname(IMAGE_DIR))) {
stop("Cannot find ", normalizePath(dirname(IMAGE_DIR), mustWork = FALSE),
"\nFix IMAGE_DIR at the top of this script.")
}
dir.create(IMAGE_DIR, showWarnings = FALSE)
# a single folder is fine too
IMAGE_DIR <- "../../penstemon_color_images/images"    # in the image repo
MANIFEST  <- "manifest.json"        # stays here; the page reads /color/manifest.json
META_LOG  <- "batch_metadata.csv"   # stays here; appended, never replaced
SPECIES   <- c("newberryi", "davidsonii")
BATCH     <- 1             # bump this by one for each new batch
N_PER_SP  <- 5           # observations per species per batch
SEED      <- 1             # fixed, so each batch number is reproducible
PAUSE     <- 0.3           # seconds between downloads
# refuse to run if the image repo is not where we think it is, rather than quietly
# creating a stray folder inside the website repo
if (!dir.exists(dirname(IMAGE_DIR))) {
stop("Cannot find ", normalizePath(dirname(IMAGE_DIR), mustWork = FALSE),
"\nFix IMAGE_DIR at the top of this script.")
}
dir.create(IMAGE_DIR, showWarnings = FALSE)
# GBIF text files contain unescaped quotes and apostrophes in place names and
# people's names. Without quote="" read.delim silently swallows rows.
# Columns are named explicitly so archives downloaded at different times still stack.
readDwCA <- function(dirs, fname, keep) {
parts <- lapply(dirs, function(d) {
x <- read.delim(file.path(d, fname), quote = "", na.strings = "",
stringsAsFactors = FALSE, fileEncoding = "UTF-8")
missing <- setdiff(keep, names(x))
if (length(missing)) stop(fname, " in ", d, " lacks: ", paste(missing, collapse = ", "))
x[, keep]
})
unique(do.call(rbind, parts))
}
occ <- readDwCA(DWCA_DIRS, "occurrence.txt",
c("gbifID", "genus", "specificEpithet", "decimalLatitude",
"decimalLongitude", "eventDate", "stateProvince", "license"))
mm  <- readDwCA(DWCA_DIRS, "multimedia.txt",
c("gbifID", "identifier", "creator"))
cat("read", nrow(occ), "occurrences and", nrow(mm), "media records\n")
# keep the two target species, with coordinates
occ <- occ[occ$specificEpithet %in% SPECIES, ]
occ <- occ[!is.na(occ$decimalLatitude) & !is.na(occ$decimalLongitude), ]
# GBIF only publishes iNaturalist records under CC0, CC BY or CC BY-NC, so this is a
# check rather than a real filter. The column arrives either as a URI
# (http://creativecommons.org/licenses/by-nc/4.0/legalcode) or as a code
# (CC_BY_NC_4_0) depending on the download, so match both, and never silently
# discard everything if neither form is recognised.
cat("\nlicence values present:\n")
print(table(occ$license, useNA = "ifany"))
reusable <- grepl("zero|cc0|/by/|by[-_]nc|cc[-_]by", occ$license, ignore.case = TRUE)
if (!any(reusable)) {
warning("No licence value was recognised, so none were dropped. Check the table above.")
} else {
cat("dropping", sum(!reusable), "records without a reusable licence\n")
occ <- occ[reusable, ]
}
# one photo per observation, the first listed
mm <- mm[!duplicated(mm$gbifID), ]
occ <- merge(occ[, c("gbifID", "genus", "specificEpithet", "decimalLatitude",
"decimalLongitude", "eventDate", "stateProvince", "license")],
mm[, c("gbifID", "identifier", "creator")],
by = "gbifID")
occ <- occ[!is.na(occ$identifier), ]
cat(nrow(occ), "observations have a usable photo\n")
print(table(occ$specificEpithet))
# never re-use an observation from an earlier batch
if (file.exists(META_LOG)) {
prev <- read.csv(META_LOG, colClasses = "character")
used <- prev$gbifID
cat("excluding", length(used), "observations used in earlier batches\n")
occ <- occ[!(as.character(occ$gbifID) %in% used), ]
cat(nrow(occ), "observations still available\n")
}
# draw the batch
set.seed(SEED + BATCH)
batch <- do.call(rbind, lapply(split(occ, occ$specificEpithet), function(d) {
d[sample(nrow(d), min(N_PER_SP, nrow(d))), ]
}))
# interleave the species so scoring order is not confounded with species
batch <- batch[sample(nrow(batch)), ]
# iNaturalist serves several sizes at the same path. GBIF usually hands over
# "original", which runs to a couple of megabytes each; "large" is about 1024px on the
# long side and a tenth the size, which is what the published pipelines use. Asking
# iNaturalist for the smaller file avoids re-encoding anything ourselves.
batch$url <- sub("/(original|medium|small|square|thumb)\\.(jpe?g|png)$",
"/large.\\2", batch$identifier, ignore.case = TRUE)
n_rewritten <- sum(batch$url != batch$identifier)
cat("requesting the large version for", n_rewritten, "of", nrow(batch), "images\n")
cat("\ndownloading", nrow(batch), "images\n")
ok <- logical(nrow(batch))
for (i in seq_len(nrow(batch))) {
dest <- file.path(IMAGE_DIR, paste0(batch$gbifID[i], ".jpg"))
if (file.exists(dest) && file.size(dest) > 5000) { ok[i] <- TRUE; next }
ok[i] <- tryCatch({
download.file(batch$url[i], dest, mode = "wb", quiet = TRUE)
file.exists(dest) && file.size(dest) > 5000
}, error = function(e) FALSE)
if (!ok[i]) cat("  failed:", batch$gbifID[i], "\n")
Sys.sleep(PAUSE)
if (i %% 25 == 0) cat("  ", i, "of", nrow(batch), "\n")
}
cat("downloaded", sum(ok), "of", nrow(batch), "\n")
batch <- batch[ok, ]
manifest <- data.frame(
file    = paste0(batch$gbifID, ".jpg"),
obsID   = as.character(batch$gbifID),
species = paste(batch$genus, batch$specificEpithet),
creator = ifelse(is.na(batch$creator), "unknown", batch$creator),
license = ifelse(grepl("^http", batch$license),
sub(".*licenses/([^/]+)/.*", "CC-\\1", batch$license),
gsub("_", "-", batch$license)),
stringsAsFactors = FALSE
)
write_json(manifest, MANIFEST, pretty = TRUE, auto_unbox = TRUE, na = "null")
# coordinates go in the cumulative log, never in the manifest the page reads
new_meta <- cbind(batch = BATCH,
batch[, c("gbifID", "genus", "specificEpithet", "decimalLatitude",
"decimalLongitude", "eventDate", "stateProvince",
"creator", "license")])
first <- !file.exists(META_LOG)
write.table(new_meta, META_LOG, sep = ",", row.names = FALSE,
col.names = first, append = !first, qmethod = "double")
cat("\nwrote manifest.json for batch", BATCH, "and appended to", META_LOG, "\n")
print(table(manifest$species))
