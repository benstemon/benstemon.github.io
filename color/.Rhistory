library(jsonlite)
INAT_CSV  <- "observations.csv"   # the iNat export, sitting in this folder
library(jsonlite)
DWCA_DIR  <- "gbif"        # folder with occurrence.txt and multimedia.txt in it
IMAGE_DIR <- "images"
# SPECIES   <- c("newberryi", "davidsonii")
SPECIES   <- c("newberryi")
N_PER_SP  <- 10           # observations per species
SEED      <- 1             # fixed, so the batch is reproducible
PAUSE     <- 0.3           # seconds between downloads
dir.create(IMAGE_DIR, showWarnings = FALSE)
# GBIF text files contain unescaped quotes and apostrophes in place names and
# people's names. Without quote="" read.delim silently swallows rows.
occ <- read.delim(file.path(DWCA_DIR, "occurrence.txt"), quote = "",
na.strings = "", stringsAsFactors = FALSE, fileEncoding = "UTF-8")
mm  <- read.delim(file.path(DWCA_DIR, "multimedia.txt"), quote = "",
na.strings = "", stringsAsFactors = FALSE, fileEncoding = "UTF-8")
cat("read", nrow(occ), "occurrences and", nrow(mm), "media records\n")
library(jsonlite)
DWCA_DIRS <- c("gbif_newberryi", "gbif_davidsonii")   # one folder per GBIF download;
# a single folder is fine too
IMAGE_DIR <- "images"
SPECIES   <- c("newberryi", "davidsonii")
N_PER_SP  <- 50           # observations per species
SEED      <- 1             # fixed, so the batch is reproducible
PAUSE     <- 0.3           # seconds between downloads
dir.create(IMAGE_DIR, showWarnings = FALSE)
# GBIF text files contain unescaped quotes and apostrophes in place names and
# people's names. Without quote="" read.delim silently swallows rows.
# Columns are named explicitly so archives downloaded at different times still stack.
readDwCA <- function(dirs, fname, keep) {
parts <- lapply(dirs, function(d) {
x <- read.delim(file.path(d, fname), quote = "", na.strings = "",
stringsAsFactors = FALSE, fileEncoding = "UTF-8")
missing <- setdiff(keep, names(x))
if (length(missing)) stop(fname, " in ", d, " lacks: ", paste(missing, collapse = ", "))
x[, keep]
})
unique(do.call(rbind, parts))
}
occ <- readDwCA(DWCA_DIRS, "occurrence.txt",
c("gbifID", "genus", "specificEpithet", "decimalLatitude",
"decimalLongitude", "eventDate", "stateProvince", "license"))
mm  <- readDwCA(DWCA_DIRS, "multimedia.txt",
c("gbifID", "identifier", "creator"))
cat("read", nrow(occ), "occurrences and", nrow(mm), "media records\n")
# keep the two target species, with coordinates
occ <- occ[occ$specificEpithet %in% SPECIES, ]
occ <- occ[!is.na(occ$decimalLatitude) & !is.na(occ$decimalLongitude), ]
# keep only reusable licences: CC0, CC BY, CC BY-NC
reusable <- grepl("publicdomain/zero|licenses/by/|licenses/by-nc/", occ$license)
cat("dropping", sum(!reusable), "records without a reusable licence\n")
occ <- occ[reusable, ]
# one photo per observation, the first listed
mm <- mm[!duplicated(mm$gbifID), ]
occ <- merge(occ[, c("gbifID", "genus", "specificEpithet", "decimalLatitude",
"decimalLongitude", "eventDate", "stateProvince", "license")],
mm[, c("gbifID", "identifier", "creator")],
by = "gbifID")
occ <- occ[!is.na(occ$identifier), ]
cat(nrow(occ), "observations have a usable photo\n")
print(table(occ$specificEpithet))
# draw the batch
set.seed(SEED)
batch <- do.call(rbind, lapply(split(occ, occ$specificEpithet), function(d) {
d[sample(nrow(d), min(N_PER_SP, nrow(d))), ]
}))
# interleave the species so scoring order is not confounded with species
batch <- batch[sample(nrow(batch)), ]
# iNaturalist serves a ~500px "medium" by default; large leaves enough corolla to click
batch$url <- sub("/medium\\.", "/large.", batch$identifier)
cat("\ndownloading", nrow(batch), "images\n")
ok <- logical(nrow(batch))
for (i in seq_len(nrow(batch))) {
dest <- file.path(IMAGE_DIR, paste0(batch$gbifID[i], ".jpg"))
if (file.exists(dest) && file.size(dest) > 5000) { ok[i] <- TRUE; next }
ok[i] <- tryCatch({
download.file(batch$url[i], dest, mode = "wb", quiet = TRUE)
file.exists(dest) && file.size(dest) > 5000
}, error = function(e) FALSE)
if (!ok[i]) cat("  failed:", batch$gbifID[i], "\n")
Sys.sleep(PAUSE)
if (i %% 25 == 0) cat("  ", i, "of", nrow(batch), "\n")
}
cat("downloaded", sum(ok), "of", nrow(batch), "\n")
